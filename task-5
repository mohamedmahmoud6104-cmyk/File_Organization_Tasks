#include <iostream>
#include <fstream>
#include <cstring>
using namespace std;

// Struct representing a student record as specified in Task 5
struct StudentRecord {
    char name[20];
    int id;
    float grade;
    char delim;
};

int main() {
    // Open "students.txt" in append mode so records are added without overwriting previous data
    ofstream outFile("students.txt", ios::app);
    if (!outFile) {
        cerr << "Error opening students.txt for writing!" << endl;
        return 1;
    }

    char choice = 'y';

    // Continue adding student records while the user enters 'y' or 'Y'
    while (choice == 'y' || choice == 'Y') {
        StudentRecord student;
        student.delim = '$'; // Delimiter character required at the end of each record

        cin.ignore(); // Clear newline character left in input buffer
        cout << "Enter student name (max 19 chars): ";
        cin.getline(student.name, 20);

        cout << "Enter student ID (integer): ";
        cin >> student.id;

        cout << "Enter student grade (float): ";
        cin >> student.grade;

        // Write record to file in the required format: Name, ID, Grade, $
        outFile << student.name << ", "
                << student.id << ", "
                << student.grade << " "
                << student.delim << endl;

        cout << "Do you want to add another student record? (y/n): ";
        cin >> choice;
    }

    outFile.close();
    cout << "Student records saved to students.txt successfully." << endl;

    return 0;
}
