#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;

int main() {
    vector<string> studentNames = {
        "mahmoud Mahmoud",
        "Youssef Ali",
        "Ahmed Mostafa",
        "Esraa Ebrahim"
    };

    sort(studentNames.begin(), studentNames.end());

    cout << "Student names sorted in ascending order:" << endl;
    for (size_t i = 0; i < studentNames.size(); i++) {
        cout << (i + 1) << ". " << studentNames[i] << endl;
    }

    return 0;
}
