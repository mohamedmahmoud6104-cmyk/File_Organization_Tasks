#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

int main() {
    string names[4] = {
        "Hadeer Mahmoud",
        "Youssef Ali",
        "Ahmed Mostafa",
        "Esraa Ebrahim"
    };

    sort(names, names + 4);

    cout << "Names in ascending order:" << endl;
    for (int i = 0; i < 4; i++) {
        cout << (i + 1) << ". " << names[i] << endl;
    }

    return 0;
}
