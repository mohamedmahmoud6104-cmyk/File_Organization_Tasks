#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    ofstream outFile("welcome.txt");
    if (!outFile) {
        cerr << "Error creating welcome.txt!" << endl;
        return 1;
    }

    string text = "Hello Everybody";
    outFile << text << endl;
    outFile.close();

    ifstream inFile("welcome.txt");
    if (!inFile) {
        cerr << "Error opening welcome.txt for reading!" << endl;
        return 1;
    }

    string content;
    getline(inFile, content);
    inFile.close();

    size_t pos = content.find("body");
    if (pos != string::npos) {
        content.replace(pos, 4, "one");
    }

    ofstream updateFile("welcome.txt");
    if (!updateFile) {
        cerr << "Error opening welcome.txt for writing!" << endl;
        return 1;
    }

    updateFile << content << endl;
    updateFile.close();

    cout << "Updated content in welcome.txt: " << content << endl;

    return 0;
}
